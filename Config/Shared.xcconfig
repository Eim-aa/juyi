#include "Version.xcconfig"

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0

// Public artifacts must contain both slices. Keeping this explicit also makes
// local Debug builds exercise the same architecture contract as Release.
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Interactive local Xcode builds default to ad-hoc signing. CI explicitly
// overrides CODE_SIGNING_ALLOWED=NO; a release archive instead supplies a
// Developer ID Application identity and team.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
